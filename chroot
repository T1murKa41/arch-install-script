#!/usr/bin/env bash
#
# Настройка новой системы внутри arch-chroot. Запускается из script.sh:
#   chroot_setup.sh <user> <hostname> <timezone> <root_uuid> <ucode> <desktop> <zsh>
# Пароли сюда не передаются — script.sh задаёт их отдельно через chpasswd.

set -Eeuo pipefail
trap 'echo "Ошибка в строке $LINENO: $BASH_COMMAND" >&2' ERR

username=$1
hostname=$2
timezone=$3
root_uuid=$4
ucode=$5
install_desktop=$6
install_zsh=$7

info()   { echo ">> $*"; }
warn()   { echo "!! $*" >&2; }
header() { echo; echo "== $* =="; }
pac()    { pacman -S --noconfirm --needed "$@"; }

header 'Время и локаль'
ln -sf "/usr/share/zoneinfo/$timezone" /etc/localtime
hwclock --systohc

sed -i -e 's/^#\(en_US\.UTF-8 UTF-8\)/\1/' -e 's/^#\(ru_RU\.UTF-8 UTF-8\)/\1/' /etc/locale.gen
locale-gen
echo 'LANG=ru_RU.UTF-8' > /etc/locale.conf
printf 'KEYMAP=ru\nFONT=cyr-sun16\n' > /etc/vconsole.conf

header 'Имя хоста и сеть'
echo "$hostname" > /etc/hostname
cat > /etc/hosts <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   $hostname.localdomain $hostname
EOF

sed -i -e 's/^#Color/Color/' -e 's/^#\?ParallelDownloads.*/ParallelDownloads = 5/' /etc/pacman.conf

systemctl enable NetworkManager systemd-timesyncd fstrim.timer

header 'Пользователь и sudo'
useradd -m -G wheel,audio,video,storage -s /bin/bash "$username"

# Отдельный файл в sudoers.d безопаснее правки /etc/sudoers; проверяем синтаксис через visudo
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel
visudo -cf /etc/sudoers.d/10-wheel >/dev/null

if [[ $install_desktop == yes ]]; then
    header 'XFCE4, SDDM, Firefox'
    pac xorg-server xfce4 sddm firefox network-manager-applet \
        pipewire pipewire-pulse wireplumber
    systemctl enable sddm
fi

header 'Загрузчик rEFInd'
mkinitcpio -P

if ! refind-install; then
    warn 'refind-install не смог создать запись в NVRAM, ставлю в резервный путь EFI/BOOT'
    refind-install --usedefault "$(findmnt -no SOURCE /boot/efi)"
fi

# Ядро лежит в /boot на ext4-разделе — rEFInd нужен драйвер для его чтения
install -Dm644 /usr/share/refind/drivers_x64/ext4_x64.efi \
    /boot/efi/EFI/refind/drivers_x64/ext4_x64.efi

ucode_opt=''
[[ $ucode != none ]] && ucode_opt="initrd=boot\\$ucode-ucode.img "

cat > /boot/refind_linux.conf <<EOF
"Arch Linux"            "root=UUID=$root_uuid rw ${ucode_opt}initrd=boot\\initramfs-linux.img"
"Arch Linux (fallback)" "root=UUID=$root_uuid rw ${ucode_opt}initrd=boot\\initramfs-linux-fallback.img"
EOF

if [[ $install_zsh == yes ]]; then
    header 'zsh и oh-my-zsh'
    pac zsh git curl

    omz_url=https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh
    if su - "$username" -c "RUNZSH=no CHSH=no sh -c \"\$(curl -fsSL $omz_url)\" '' --unattended"; then
        chsh -s /bin/zsh "$username"
    else
        warn 'не удалось установить oh-my-zsh, оставляю bash'
    fi
fi

rm -f -- "$0"
info 'Настройка в chroot завершена'
